---
// Garisan Pasang Surut — a calm editorial coast route built around real Pantai Merdeka photography, direct local guidance and tide-line motifs.
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';

const title = 'Pantai Merdeka · Panduan Pesisir Kuala Muda';
const description = 'Panduan ringkas untuk menikmati Pantai Merdeka di Kota Kuala Muda, Kedah — pantai, arah, makan, kemudahan dan tempat berdekatan.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const placeData = {
  '@context': 'https://schema.org', '@type': ['TouristAttraction', 'LocalBusiness'], name: 'Pantai Merdeka',
  ...(canonical ? { url: canonical.toString(), '@id': `${canonical.toString()}#pantai-merdeka` } : {}), description,
  address: { '@type': 'PostalAddress', streetAddress: 'Pantai Merdeka', addressLocality: 'Kota Kuala Muda', postalCode: '08500', addressRegion: 'Kedah', addressCountry: 'MY' },
  geo: { '@type': 'GeoCoordinates', latitude: 5.666111, longitude: 100.3675 },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '00:00', closes: '23:59' }],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.1', reviewCount: '5238', bestRating: '5', worstRating: '1' }
};
const faqItems = [
  { q: 'Adakah masuk ke Pantai Merdeka dikenakan bayaran?', a: 'Akses ke kawasan pantai lazimnya percuma. Aktiviti, tandas, bot dan perkhidmatan gerai adalah berasingan, jadi semak terus di lokasi sebelum membuat keputusan.' },
  { q: 'Bilakah waktu yang baik untuk datang?', a: 'Bagi suasana yang lebih selesa, pilih lewat petang apabila panas berkurang dan angin laut terasa lebih baik. Keadaan cuaca serta pasang surut berubah; utamakan nasihat keselamatan di lokasi.' },
  { q: 'Bolehkah saya menaiki bot ke Tanjung Dawai?', a: 'Terdapat perkhidmatan bot yang menghubungkan kawasan ini dengan Tanjung Dawai merentasi Sungai Merbok. Jadual, tambang, keadaan cuaca dan operasi adalah tertakluk kepada pengendali setempat.' },
  { q: 'Ada tempat makan dan tandas?', a: 'Gerai makanan dan tandas awam dilaporkan berada berhampiran pantai. Pilihan, waktu operasi dan caj tandas boleh berubah mengikut hari serta pengendali.' },
  { q: 'Adakah sesuai untuk berkhemah semalaman?', a: 'Rancang Pantai Merdeka sebagai lawatan sehari kecuali anda telah mengesahkan penginapan atau tapak perkhemahan yang sah secara berasingan.' }
];
const faqData = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout {title} {description}>
  <header class="site-header"><div class="header-inner"><a class="brand" href="#utama" aria-label="Pantai Merdeka, kembali ke permulaan"><LogoMark class="brand-mark" /><span>Pantai<br />Merdeka</span></a><nav class="nav" aria-label="Navigasi utama"><a href="#rancang">Rancang</a><a href="#rasa">Makan</a><a href="#arah">Arah</a><a href="#soalan">FAQ</a></nav></div></header>
  <main id="kandungan">
    <section id="utama" class="hero paper-grain" aria-labelledby="hero-title"><img class="hero-photo" src="/gallery/pantai-merdeka-2.jpg" alt="Pemandangan pantai dan laut di Pantai Merdeka" /><div class="hero-overlay"></div><svg class="topo hero-contours" viewBox="0 0 720 420" aria-hidden="true"><path d="M12 330C120 203 134 391 270 259S430 70 522 228s135 83 187-52"/><path d="M-8 363C115 233 167 437 313 289S454 110 552 261s100 53 188-48"/><path d="M0 278c126-140 174 58 276-80S424 21 509 172s120 86 216-49"/><path d="M45 211c106-101 142 43 239-70S424-17 495 116s121 79 193-40"/></svg><div class="hero-inner"><div class="hero-grid"><div class="reveal"><p class="eyebrow" style="color: var(--seafoam)">Kota Kuala Muda · Kedah</p><h1 id="hero-title">Laut, angin &amp; petang yang panjang.</h1><p class="hero-lede">Pantai Merdeka ialah tempat untuk tiba perlahan, membentang tikar, makan sesuatu yang hangat dan menunggu warna langit berubah.</p><div class="hero-actions"><a class="button button--warm" href="#arah">Cari arah</a><a class="button" href="#rancang">Rancang lawatan</a></div></div><aside class="hero-side reveal" aria-label="Maklumat ringkas"><p>Koordinat</p><strong>5.666111° N<br />100.367500° E</strong><p style="margin-top:1.5rem">Akses kawasan</p><strong>Setiap hari<br />Sepanjang hari</strong></aside></div></div><div class="scroll-note">Ikut garisan air</div></section>
    <section class="intro" data-stamp="05°39′58″N · 100°22′03″E" aria-labelledby="tentang-title"><div class="intro-grid"><div><p class="section-number">01 — Kenali pantai</p><p class="eyebrow">Seperti yang ada</p><h2 class="section-title" id="tentang-title">Bukan resort. Itulah pesonanya.</h2><p class="section-copy">Di pesisir Kuala Muda, Pantai Merdeka lebih dekat kepada ritual keluarga hujung minggu daripada destinasi yang dibina-bina. Ruangnya terbuka, suasananya kampung dan petangnya paling sesuai dinikmati tanpa tergesa-gesa.</p><dl class="facts"><div class="fact"><dt>Lokasi</dt><dd>08500 Kota Kuala Muda, Kedah</dd></div><div class="fact"><dt>Masuk</dt><dd>Kawasan pantai lazimnya percuma</dd></div><div class="fact"><dt>Sesuai untuk</dt><dd>Berjalan, berkelah &amp; melihat senja</dd></div><div class="fact"><dt>Nota</dt><dd>Kemudahan beroperasi mengikut pengendali</dd></div></dl></div><figure class="intro-visual reveal"><img src="/images/sunset-pantai-merdeka.jpg" alt="Langit senja di atas laut Pantai Merdeka" loading="lazy" /><figcaption class="photo-caption">DATANG UNTUK CAHAYA PETANG, TINGGAL UNTUK ANGIN LAUT</figcaption></figure></div></section>
    <section id="rancang" class="visit" data-stamp="CAP LAPANGAN · PETANG" aria-labelledby="rancang-title"><div class="visit-head"><div><p class="section-number">02 — Rancang hari</p><p class="eyebrow">Nota praktikal</p><h2 class="section-title" id="rancang-title">Petang yang mudah, jika tahu apa hendak dibawa.</h2></div><p class="section-copy">Ambil yang perlu, jangka cuaca panas pada tengah hari dan simpan ruang untuk spontan. Pantai ini lebih baik sebagai lawatan santai daripada jadual yang padat.</p></div><div class="visit-layout"><div><dl class="info-list"><div><dt>Masa terbaik</dt><dd>Lewat petang hingga senja untuk cahaya yang lebih lembut dan angin laut yang lazimnya lebih selesa.</dd></div><div><dt>Tempoh tinggal</dt><dd>Rancang sekitar 2–4 jam untuk bersiar, berkelah, makan dan melihat langit berubah.</dd></div><div><dt>Bayaran</dt><dd>Akses pantai dilaporkan percuma; bawa wang kecil untuk tandas, makanan, aktiviti atau bot jika ada.</dd></div><div><dt>Parkir</dt><dd>Kawasan letak kereta berhampiran pantai biasanya tersedia. Hujung minggu dan cuti boleh lebih sibuk; tiba awal jika perlu.</dd></div></dl><p class="visit-note"><strong>Jaga pantai bersama-sama.</strong> Bawa pulang sampah, gunakan tong yang ada dan jangan memberi makan hidupan liar yang menghampiri kawasan pelawat.</p></div><aside class="visit-graphic paper-grain"><div class="tide-note-art" aria-hidden="true"><LogoMark /><span>Nota lapangan<br />Kuala Muda<br />Pesisir Kedah</span></div><p>Tip ringkas: bawa topi, air minuman, tikar dan sedikit wang tunai. Periksa cuaca, keadaan laut dan arahan tempatan sebelum masuk ke air.</p></aside></div></section>
    <section class="experience" data-stamp="GARIS AIR · 02—04 JAM" aria-labelledby="buat-title"><div class="experience-head"><p class="section-number">03 — Buat perlahan</p><p class="eyebrow">Ritma pantai</p><h2 class="section-title" id="buat-title">Biarkan hari bergerak seperti ombak.</h2></div><div class="experience-grid"><figure class="experience-photo reveal"><img src="/images/walkway-pantai-merdeka.jpg" alt="Laluan tepi laut dan pepohon di Pantai Merdeka" loading="lazy" /><figcaption class="photo-tag">Ruang terbuka, rentak sendiri</figcaption></figure><div class="experience-notes"><article><h3>Berjalan di tepi air</h3><p>Pilih kasut yang sesuai untuk permukaan pesisir dan nikmati garis air mengikut keadaan pasang surut.</p></article><article><h3>Hampar tikar</h3><p>Ruang pantai sesuai untuk keluarga yang mahu berehat, makan ringan dan membiarkan anak-anak bermain di kawasan yang dipantau.</p></article><article><h3>Tunggu senja</h3><p>Pemandangan terbuka ke laut menjadikan lewat petang alasan yang cukup untuk tidak pulang terlalu awal.</p></article><article><h3>Fikir sebelum berenang</h3><p>Keadaan air berubah-ubah. Pilih aktiviti air hanya apabila cuaca, arus dan arahan keselamatan setempat mengizinkan.</p></article></div></div></section>
    <section id="rasa" class="food" data-stamp="WARUNG · PESISIR" aria-labelledby="makan-title"><div class="food-layout"><div><p class="section-number">04 — Rasa sekitar</p><p class="eyebrow">Makan di pesisir</p><h2 class="section-title" id="makan-title">Mulakan dengan apa yang dekat.</h2><p class="section-copy">Gerai di sekitar pantai memudahkan makanan ringkas selepas bersiar. Untuk pilihan lebih luas, teruskan perjalanan ke pekan pesisir berdekatan.</p><div class="food-list"><article><h3>Makanan laut setempat</h3><p>Pilihan lazim di kawasan pesisir; tanya ketersediaan, harga dan cara masakan terus di gerai atau restoran.</p></article><article><h3>Gerai minuman &amp; snek</h3><p>Sesuai untuk berhenti pendek. Waktu operasi boleh berbeza antara hari biasa dan hujung minggu.</p></article><article><h3>Tanjung Dawai</h3><p>Seberang Sungai Merbok ialah pilihan logik untuk meneruskan hari dengan suasana pekan nelayan dan pilihan makan yang lain.</p></article></div></div><figure class="food-photo reveal"><img src="/images/shade-pantai-merdeka.jpeg" alt="Pokok-pokok teduh di tepi Pantai Merdeka" loading="lazy" /><figcaption><strong>Cadangan:</strong> semak waktu operasi terus dengan perniagaan pilihan anda, khususnya pada hari bekerja atau ketika cuaca buruk.</figcaption></figure></div></section>
    <section id="arah" class="routes" data-stamp="LALUAN · DARAT &amp; AIR" aria-labelledby="arah-title"><div class="routes-grid"><div><p class="section-number">05 — Sampai ke sini</p><p class="eyebrow">Arah &amp; pergerakan</p><h2 class="section-title" id="arah-title">Pilih jalan yang paling masuk akal untuk hari anda.</h2><p class="section-copy">Pantai Merdeka paling mudah dikunjungi dengan kenderaan sendiri. Gunakan peta untuk keadaan trafik semasa dan sahkan sambungan awam dengan operator sebelum bertolak.</p><div class="route-cards"><article class="route-card"><span>Dari udara</span><h3>Lapangan Terbang Antarabangsa Pulau Pinang</h3><p>Teruskan dengan kereta sewa atau e-panggilan; laluan darat paling praktikal untuk sampai ke Kota Kuala Muda.</p></article><article class="route-card"><span>Dengan bas</span><h3>Sungai Petani sebagai titik sambung</h3><p>Dari terminal bandar, sambung dengan teksi, e-panggilan atau pengangkutan yang telah diatur ke pantai.</p></article><article class="route-card"><span>Dengan teksi</span><h3>Tempah perjalanan terus</h3><p>Tetapkan titik ambil balik terlebih dahulu kerana liputan e-panggilan boleh berbeza di kawasan pesisir.</p></article><article class="route-card"><span>Dengan kereta</span><h3>Ikut peta ke Pantai Merdeka</h3><p>Laluan berturap membawa hingga ke kawasan pantai; ikut papan tanda dan arahan setempat ketika tiba.</p></article></div></div><div class="map-frame"><iframe title="Peta Pantai Merdeka" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d127050.24604874113!2d100.21504719726559!3d5.666757000000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304b273c97b62277%3A0x5439c36b581a8d00!2sPantai%20Merdeka!5e0!3m2!1sms!2smy!4v1786602456303!5m2!1sms!2smy" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><span class="map-label">Peta Google · Bahasa Melayu</span></div></div></section>
    <section class="nearby" data-stamp="MERBOK · KUALA MUDA" aria-labelledby="dekat-title"><div class="nearby-head"><p class="section-number" style="color:var(--seafoam)">06 — Teruskan perjalanan</p><p class="eyebrow" style="color:var(--seafoam)">Di sekitar Kuala Muda</p><h2 class="section-title" id="dekat-title">Ada lagi di seberang dan sepanjang pesisir.</h2><p class="section-copy">Jadikan pantai sebagai sebahagian daripada hari yang lebih luas, bukan satu-satunya hentian.</p></div><div class="nearby-grid"><article class="nearby-card"><span>Merentasi sungai</span><h3>Tanjung Dawai</h3><p>Pekan pesisir yang dihubungkan oleh bot merentasi Sungai Merbok, tertakluk kepada operasi semasa.</p></article><article class="nearby-card"><span>Jejak alam</span><h3>Muara Merbok</h3><p>Kawasan sungai dan pesisir yang mengingatkan bahawa Kuala Muda dibentuk oleh air, bakau dan kampung nelayan.</p></article><article class="nearby-card"><span>Pemandangan jauh</span><h3>Gunung Jerai</h3><p>Gunung ikonik Kedah yang kadangkala membingkai pandangan dari pesisir ketika cuaca mengizinkan.</p></article></div></section>
    <section id="soalan" class="faq" data-stamp="SEMAK DI LOKASI" aria-labelledby="faq-title"><div class="faq-grid"><div><p class="section-number">07 — Tanya dahulu</p><p class="eyebrow">FAQ</p><h2 class="section-title" id="faq-title">Jawapan ringkas sebelum bertolak.</h2><p class="section-copy">Maklumat praktikal berubah mengikut cuaca, cuti dan pengendali. Gunakan soalan ini sebagai persediaan, kemudian semak keadaan di lokasi.</p></div><div class="faq-list">{faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>
  </main>
  <footer class="site-footer"><div class="footer-grid"><a class="brand" href="#utama"><LogoMark class="brand-mark" /><span>Pantai<br />Merdeka</span></a><p>Tapak ini ialah panduan pelawat tidak rasmi dan tidak berafiliasi dengan mana-mana pihak berkuasa, pengendali tarikan atau Google. Maklumat kemudahan, cuaca, bot dan perniagaan boleh berubah; sahkan terus sebelum lawatan.</p><div class="footer-links"><a href="#rancang">Rancang</a><a href="#arah">Arah</a><a href="#soalan">FAQ</a></div></div></footer>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(placeData)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqData)}></script>
</BaseLayout>
